{
  "realm": "micro-commerce",
  "displayName": "MicroCommerce",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "platform-operator",
        "description": "Staff running the Marketplace."
      }
    ]
  },
  "clients": [
    {
      "clientId": "micro-commerce-api",
      "name": "MicroCommerce API",
      "description": "Token audience for the API. Never used to sign in.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "micro-commerce-web",
      "name": "MicroCommerce web app",
      "description": "The browser SPA. Public client: authorization code with PKCE, no secret.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "micro-commerce-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "micro-commerce-tests",
      "name": "MicroCommerce integration tests",
      "description": "Public client with direct access grants so integration tests can get a token for a seeded Account. Dev realm only.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "micro-commerce-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "buyer",
      "email": "buyer@micro-commerce.test",
      "emailVerified": true,
      "firstName": "Bea",
      "lastName": "Buyer",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${MC_BUYER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "operator",
      "email": "operator@micro-commerce.test",
      "emailVerified": true,
      "firstName": "Olive",
      "lastName": "Operator",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${MC_OPERATOR_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "platform-operator"
      ]
    }
  ]
}
